{
	"name": "stormrockwell/mcp-server",
	"description": "A starter MCP server for WordPress built on the Abilities API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^3.0",
		"wp-phpunit/wp-phpunit": "^7.0",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": { "McpServer\\": "src/" }
	},
	"autoload-dev": {
		"psr-4": { "McpServer\\Tests\\": "tests/" }
	},
	"config": {
		"allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": "phpunit",
		"package": "bash bin/package.sh"
	}
}
